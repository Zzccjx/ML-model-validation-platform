# AI/ML Model Validation & Assurance Platform
# Copy this file to .env and update values

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_validation

# Security - CHANGE THESE IN PRODUCTION
SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_SECRET=change-me-to-a-random-jwt-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Storage
UPLOAD_DIRECTORY=./uploads
MAX_UPLOAD_SIZE_MB=100

# CORS
CORS_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=INFO
